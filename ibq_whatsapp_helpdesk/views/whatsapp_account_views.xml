<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_whatsapp_account_tree" model="ir.ui.view">
        <field name="name">whatsapp.account.tree</field>
        <field name="model">ibq.whatsapp.account</field>
        <field name="arch" type="xml">
            <tree string="WhatsApp Accounts">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="phone_number"/>
                <field name="team_id"/>
                <field name="bot_flow_id"/>
                <field name="conversation_count" string="Chats"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-danger="state == 'error'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_whatsapp_account_form" model="ir.ui.view">
        <field name="name">whatsapp.account.form</field>
        <field name="model">ibq.whatsapp.account</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Account">
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Connection" class="btn-primary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_conversations" type="object"
                                class="oe_stat_button" icon="fa-comments">
                            <field name="conversation_count" widget="statinfo"
                                   string="Conversations"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="IBQ Support Line"/></h1>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'error'">
                        <field name="last_error" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="provider" widget="radio"/>

                            <!-- Meta Cloud API -->
                            <field name="meta_phone_number_id" placeholder="123456789012345"
                                   invisible="provider != 'meta'"
                                   required="provider == 'meta'"/>
                            <field name="meta_waba_id" placeholder="123456789012345"
                                   invisible="provider != 'meta'"/>
                            <field name="meta_access_token" password="True"
                                   invisible="provider != 'meta'"
                                   required="provider == 'meta'"/>
                            <field name="meta_app_secret" password="True"
                                   invisible="provider != 'meta'"/>
                            <field name="meta_verify_token"
                                   placeholder="any string you also paste into Meta"
                                   invisible="provider != 'meta'"/>
                            <field name="meta_api_version" invisible="provider != 'meta'"/>

                            <!-- Twilio -->
                            <field name="account_sid" placeholder="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
                                   invisible="provider != 'twilio'"
                                   required="provider == 'twilio'"/>
                            <field name="auth_token" password="True"
                                   invisible="provider != 'twilio'"
                                   required="provider == 'twilio'"/>
                            <field name="sender_mode" widget="radio"
                                   invisible="provider != 'twilio'"/>

                            <field name="phone_number" placeholder="+14155238886"
                                   invisible="provider == 'twilio' and sender_mode != 'number'"
                                   required="provider == 'meta' or sender_mode == 'number'"/>
                            <field name="messaging_service_sid" placeholder="MGxxxxxxxx"
                                   invisible="provider != 'twilio' or sender_mode != 'service'"
                                   required="provider == 'twilio' and sender_mode == 'service'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Helpdesk Routing">
                            <field name="team_id"/>
                            <field name="bot_flow_id"/>
                            <field name="auto_create_ticket"/>
                            <field name="unknown_contact_action"/>
                            <field name="session_hours"/>
                            <field name="ask_rating"/>
                            <field name="allow_agent_commands"/>
                        </group>
                    </group>
                    <group string="Webhooks">
                        <div class="text-muted" colspan="2" invisible="provider != 'meta'">
                            Paste the Callback URL and the Verify Token into the Meta app
                            dashboard, under WhatsApp &gt; Configuration &gt; Webhook, then
                            subscribe to the <strong>messages</strong> field. Meta delivers
                            inbound messages and delivery receipts to this one URL.
                        </div>
                        <div class="text-muted" colspan="2" invisible="provider != 'twilio'">
                            Paste these into the Twilio Console, on the WhatsApp sender
                            (Messaging &gt; Senders) or the Messaging Service you use.
                        </div>
                        <field name="inbound_webhook_url" readonly="1"
                               string="Callback URL"/>
                        <field name="status_webhook_url" readonly="1"
                               string="Status callback"
                               invisible="provider == 'meta'"/>
                        <field name="webhook_base_url"
                               placeholder="https://your-tunnel.ngrok-free.app"/>
                        <field name="verify_signature"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_account" model="ir.actions.act_window">
        <field name="name">WhatsApp Accounts</field>
        <field name="res_model">ibq.whatsapp.account</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect a WhatsApp sender</p>
            <p>
                On Meta, take the Phone Number ID and a permanent Access Token from the
                app dashboard, add the App Secret, then paste the Callback URL and your
                Verify Token back into Meta and subscribe to the messages field.
            </p>
            <p>
                On Twilio, take the Account SID and Auth Token from the console, pick the
                WhatsApp sender, then copy the two webhook URLs back into Twilio.
            </p>
        </field>
    </record>

</odoo>
