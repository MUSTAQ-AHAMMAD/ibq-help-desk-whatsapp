<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Tags
         ============================================================ -->
    <record id="view_whatsapp_tag_tree" model="ir.ui.view">
        <field name="name">whatsapp.tag.tree</field>
        <field name="model">whatsapp.tag</field>
        <field name="arch" type="xml">
            <tree string="Tags" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="team_ids" widget="many2many_tags"/>
                <field name="conversation_count" string="Used on"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="action_whatsapp_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">whatsapp.tag</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Label what chats are about</p>
            <p>
                Tags are what make the reports say something useful. Without them
                every chat is just "a chat", and the only breakdown available is by
                agent or department.
            </p>
        </field>
    </record>

    <!-- ============================================================
         Canned responses
         ============================================================ -->
    <record id="view_whatsapp_canned_tree" model="ir.ui.view">
        <field name="name">whatsapp.canned.response.tree</field>
        <field name="model">whatsapp.canned.response</field>
        <field name="arch" type="xml">
            <tree string="Saved Replies">
                <field name="sequence" widget="handle"/>
                <field name="shortcut"/>
                <field name="name"/>
                <field name="body"/>
                <field name="owner_id" string="Private to" optional="show"/>
                <field name="team_ids" widget="many2many_tags" optional="show"/>
                <field name="usage_count" string="Used" optional="show"/>
                <field name="last_used" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_whatsapp_canned_form" model="ir.ui.view">
        <field name="name">whatsapp.canned.response.form</field>
        <field name="model">whatsapp.canned.response</field>
        <field name="arch" type="xml">
            <form string="Saved Reply">
                <sheet>
                    <div class="oe_title">
                        <label for="shortcut"/>
                        <h1>
                            <span class="text-muted">/</span><field name="shortcut"
                                   placeholder="order-status" class="oe_inline"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" placeholder="Where is my order?"/>
                            <field name="owner_id" string="Private to"
                                   placeholder="Shared with the team"/>
                        </group>
                        <group>
                            <field name="team_ids" widget="many2many_tags"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="usage_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="body" nolabel="1" colspan="2"
                               placeholder="Hi {name}, your order {order_ref} is on its way."/>
                        <div class="text-muted" colspan="2">
                            Placeholders: <code>{name}</code>, <code>{number}</code>,
                            <code>{agent}</code>, <code>{ticket_ref}</code>, and any
                            answer the bot collected.
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_canned" model="ir.actions.act_window">
        <field name="name">Saved Replies</field>
        <field name="res_model">whatsapp.canned.response</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Stop retyping the same sentences</p>
            <p>
                Agents insert these with <b>/shortcut</b> in the dashboard composer.
                Leave <i>Private to</i> empty to share one with the whole team.
            </p>
        </field>
    </record>

    <!-- ============================================================
         Ratings
         ============================================================ -->
    <record id="view_whatsapp_rating_tree" model="ir.ui.view">
        <field name="name">whatsapp.rating.tree</field>
        <field name="model">whatsapp.rating</field>
        <field name="arch" type="xml">
            <tree string="Satisfaction" create="false"
                  decoration-danger="sentiment == 'unhappy'"
                  decoration-success="sentiment == 'happy'">
                <field name="create_date" string="When"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="score"/>
                <field name="sentiment" widget="badge"/>
                <field name="comment"/>
                <field name="ticket_id" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_whatsapp_rating_graph" model="ir.ui.view">
        <field name="name">whatsapp.rating.graph</field>
        <field name="model">whatsapp.rating</field>
        <field name="arch" type="xml">
            <graph string="Satisfaction" type="bar">
                <field name="user_id"/>
                <field name="score_value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_whatsapp_rating" model="ir.actions.act_window">
        <field name="name">Satisfaction</field>
        <field name="res_model">whatsapp.rating</field>
        <field name="view_mode">tree,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No ratings yet</p>
            <p>
                When a chat an agent handled is closed, the customer is asked to
                score it from 1 to 5. Turn that off per sender on the account form.
            </p>
        </field>
    </record>

    <!-- ============================================================
         Blocklist
         ============================================================ -->
    <record id="view_whatsapp_blocklist_tree" model="ir.ui.view">
        <field name="name">whatsapp.blocklist.tree</field>
        <field name="model">whatsapp.blocklist</field>
        <field name="arch" type="xml">
            <tree string="Blocked Numbers" editable="bottom">
                <field name="number"/>
                <field name="partner_id"/>
                <field name="reason"/>
                <field name="note"/>
                <field name="hit_count" string="Dropped"/>
                <field name="last_hit" optional="hide"/>
                <field name="blocked_by" readonly="1"/>
                <field name="blocked_on" readonly="1"/>
                <button name="action_unblock" type="object" string="Unblock"
                        icon="fa-unlock" class="btn-link"/>
            </tree>
        </field>
    </record>

    <record id="action_whatsapp_blocklist" model="ir.actions.act_window">
        <field name="name">Blocked Numbers</field>
        <field name="res_model">whatsapp.blocklist</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing is blocked</p>
            <p>
                Messages from a blocked number are dropped on arrival: no conversation,
                no ticket, no reply. Nothing is sent back, because a reply would
                confirm the number is live.
            </p>
        </field>
    </record>

    <!-- ============================================================
         Analysis views on conversations
         ============================================================ -->
    <record id="view_whatsapp_conversation_pivot" model="ir.ui.view">
        <field name="name">whatsapp.conversation.pivot</field>
        <field name="model">whatsapp.conversation</field>
        <field name="arch" type="xml">
            <pivot string="Conversation Analysis" sample="1">
                <field name="team_id" type="row"/>
                <field name="state" type="col"/>
                <field name="first_response_seconds" type="measure"/>
                <field name="resolution_seconds" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_whatsapp_conversation_graph" model="ir.ui.view">
        <field name="name">whatsapp.conversation.graph</field>
        <field name="model">whatsapp.conversation</field>
        <field name="arch" type="xml">
            <graph string="Conversation Analysis" type="line" sample="1">
                <field name="create_date" interval="day"/>
            </graph>
        </field>
    </record>

    <record id="action_whatsapp_conversation_analysis" model="ir.actions.act_window">
        <field name="name">Conversation Analysis</field>
        <field name="res_model">whatsapp.conversation</field>
        <field name="view_mode">graph,pivot,tree,form</field>
        <field name="context">{'search_default_group_team': 1}</field>
    </record>

</odoo>
