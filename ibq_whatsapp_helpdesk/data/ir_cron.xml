<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_whatsapp_send_queue" model="ir.cron">
            <field name="name">WhatsApp: send queued messages</field>
            <field name="model_id" ref="model_whatsapp_message"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_queued()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
        </record>

        <record id="cron_whatsapp_close_idle" model="ir.cron">
            <field name="name">WhatsApp: close idle conversations</field>
            <field name="model_id" ref="model_whatsapp_conversation"/>
            <field name="state">code</field>
            <field name="code">model._cron_close_idle(int(env['ir.config_parameter'].sudo().get_param('ibq_whatsapp.idle_close_hours', 48)))</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
        </record>


        <record id="cron_whatsapp_classify_issues" model="ir.cron">
            <field name="name">WhatsApp: classify issues</field>
            <field name="model_id" ref="model_whatsapp_issue"/>
            <field name="state">code</field>
            <field name="code">model._cron_classify()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
        </record>

    </data>
</odoo>
